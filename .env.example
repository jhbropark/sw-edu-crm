# --- Database (Supabase / Neon Postgres) ---
DATABASE_URL="postgresql://user:password@host:6543/dbname?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@host:5432/dbname"  # 마이그레이션용(직결)

# --- Auth ---
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"   # 운영: https://crm.varis.kr

# --- 앱 ---
NEXT_PUBLIC_APP_URL="https://crm.varis.kr"

# --- 토스페이먼츠 ---
TOSS_SECRET_KEY="test_sk_xxx"                 # 서버 전용(절대 노출 금지)
NEXT_PUBLIC_TOSS_CLIENT_KEY="test_ck_xxx"     # 클라이언트 결제위젯용
TOSS_WEBHOOK_SECRET="whsec_xxx"               # 웹훅 서명검증(운영 필수)
ALLOW_UNVERIFIED_WEBHOOK="0"                  # 1이면 서명검증 우회(개발 전용)

# --- SOLAPI (알림톡/문자) ---
SOLAPI_API_KEY="xxx"
SOLAPI_API_SECRET="xxx"
SOLAPI_SENDER="01000000000"                   # 사전 등록된 발신번호
KAKAO_PFID="KAxxxxxxxx"                        # 카카오 발신프로필(채널) ID
KAKAO_TPL_LEAD_REPLY="tpl_lead_reply"          # 리드 자동응답 템플릿 ID
KAKAO_TPL_RECEIPT="tpl_receipt"                # 결제 안내 템플릿 ID

# --- 이메일 (Resend, Phase 2) ---
RESEND_API_KEY="re_xxx"
MAIL_FROM="no-reply@varis.kr"

# --- Cron 보호용 ---
CRON_SECRET="generate-a-random-string"

# --- 개인정보 보관기간(일) ---
PRIVACY_RETENTION_DAYS="365"
